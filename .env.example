# Aplicação
APP_NAME=api-controla-ai
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
LOG_LEVEL=INFO
TZ=America/Sao_Paulo

# Imagem
IMAGE_NAME=controla-ai/api
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_USER=controlaai
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=controlaai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://controlaai:troque_esta_senha@postgres:5432/controlaai
DATABASE_SCHEMA=controla_ai
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=15
DATABASE_COMMAND_TIMEOUT=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_METERING_DB=2

# Armazenamento de comprovantes
RECEIPT_STORAGE_ROOT=/var/lib/controlaai/receipts
RECEIPT_MAX_SIZE_BYTES=10485760
RECEIPT_ALLOWED_MIME=image/jpeg,image/png,application/pdf

# Segurança
APP_UID=1000
APP_GID=1000
JWE_PRIVATE_KEY_PATH=/run/secrets/jwe_private.pem
JWE_PUBLIC_KEY_PATH=/run/secrets/jwe_public.pem
JWE_ALGORITHM=RSA-OAEP-256
JWE_ENCRYPTION=A256GCM
JWE_ISSUER=https://api.controla.ai
JWE_AUDIENCE=controla-ai-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# OCR
OCR_LANGUAGE=por
OCR_CONFIDENCE_THRESHOLD=0.85

# LLM
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=coloque_sua_chave_aqui
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

# Callback do parceiro
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_SECONDS=2.0

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Gunicorn - produção apenas
GUNICORN_WORKERS=4

# Assistente financeiro
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.25
RAG_MAX_CONTEXT_CHARS=6000
ASSISTANT_HISTORY_TURNS=5
RAG_INDEX_BATCH_SIZE=200
RAG_INDEX_CRON_MINUTES=15

# Recorrências
SUBSCRIPTION_ALERT_LEAD_DAYS=3
SUBSCRIPTION_NOTIFY_CRON_HOUR=8
SUBSCRIPTION_SWEEP_BATCH_SIZE=500

# Assets
ASSET_PROPERTY_DEPRECIATION_RATE=0.0
ASSET_OTHER_DEPRECIATION_RATE=0.0083
ASSET_VEHICLE_DEPRECIATION_RATE=0.0167

# Análise de ofensores
PARETO_CUTOFF_RATIO=0.8
PARETO_ESSENTIAL_CATEGORIES="Moradia,Aluguel,Condomínio,Energia Elétrica,Água e Esgoto,Gás,Internet,Plano de Saúde,Educação"

# Metas financeiras
GOAL_ANNUAL_RISK_FREE_RATE=0.1075
GOAL_MAX_PROJECTION_MONTHS=600
GOAL_CAPACITY_LOOKBACK_MONTHS=6

# Exportação interoperável
EXPORT_STORAGE_ROOT=/var/lib/controlaai/exports
EXPORT_RETENTION_SECONDS=86400
EXPORT_PDF_MAX_ROWS_PER_SECTION=5000

# Painel fiscal
TAX_ANNUAL_BRACKETS="2026:26963.20:0:0,2026:33919.80:0.075:2022.24,2026:45012.60:0.15:4566.23,2026:55976.16:0.225:7942.17,2026::0.275:10740.98"
TAX_UNLIMITED_CEILING=9999999999999.99
TAX_CONSOLIDATION_CRON_HOUR=3
TAX_CONSOLIDATION_BATCH_SIZE=500
TAX_EDUCATION_CEILING_BY_YEAR="2024:3561.50,2025:3561.50,2026:3561.50"
TAX_CONSOLIDATION_MAX_AGE_HOURS=24
TAX_DEDUCTIBLE_HEALTH_CATEGORIES="Saúde,Plano de Saúde,Consulta Médica,Exames,Odontologia,Fisioterapia,Psicologia,Internação Hospitalar"
TAX_DEDUCTIBLE_EDUCATION_CATEGORIES="Educação,Mensalidade Escolar,Faculdade,Pós-Graduação,Creche,Ensino Técnico"

# Medição de consumo e faturamento
METERING_FLUSH_CRON_MINUTES=5
METERING_CLAIM_BATCH_SIZE=1000
BILLING_INVOICE_CLOSE_CRON_HOUR=2
BILLING_LIST_BASE_MONTHLY_FEE=499.00
BILLING_LIST_PRICE_PER_OCR_IMAGE=0.08
BILLING_LIST_PRICE_PER_THOUSAND_REQUESTS=2.50
BILLING_LIST_PRICE_PER_MILLION_TOKENS_IN=4.00
BILLING_LIST_PRICE_PER_MILLION_TOKENS_OUT=16.00